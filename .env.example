# Copy this to `.env` and fill in what you need. Anything prefixed with
# EXPO_PUBLIC_ is inlined at build time by Expo and accessible via
# `process.env.EXPO_PUBLIC_*` in app code.

# ─────────────────────────────────────────────────────────────────────────────
# Backend URL
# ─────────────────────────────────────────────────────────────────────────────

# Explicit override — wins over everything else, in every build.
# Use this to point at a staging server, ngrok tunnel, or a remote dev box.
# Leave commented to let dev/prod defaults take over.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Production base URL. Used when __DEV__ is false (release builds).
# EXPO_PUBLIC_API_PROD_URL=https://api.bookie.app

# Dev-only knobs (ignored when __DEV__ is false).
# Pin the backend's LAN host explicitly — leave commented out to let
# src/lib/config.ts auto-detect from Metro / Expo Go.
# EXPO_PUBLIC_LAN_HOST=192.168.1.42
# Dev backend port (default 8080)
# EXPO_PUBLIC_API_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────

# Sentry DSN — leave unset for local dev (Sentry no-ops without a DSN).
# EXPO_PUBLIC_SENTRY_DSN=https://abc@sentry.io/1234
