{
  "expo": {
    "name": "Bookie",
    "slug": "Bookie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bookie-app-icon.png",
    "scheme": "bookie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE4D1",
        "foregroundImage": "./assets/images/bookie-addaptive-icon.png",
        "backgroundImage": "./assets/images/bookie-adaptive-bg.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.getbookie.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE4D1",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 150
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94b5cd26-a5de-4295-a3ad-eb572b9f9b99"
      }
    }
  }
}
